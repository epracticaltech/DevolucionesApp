# ==========================================
# Git Ignore Raíz - DevolucionesApp
# (Backend Spring Boot + Frontend Angular)
# ==========================================

# ── Archivos de Sistema ──
.DS_Store
Thumbs.db

# ── Entorno y Secretos ──
.env
*.local

# ── Backend (Java / Maven / Spring Boot) ──
**/target/
**/.mvn/wrapper/maven-wrapper.jar
**/HELP.md

# ── Frontend (Node / Angular) ──
**/node_modules/
**/dist/
**/tmp/
**/out-tsc/
**/.angular/cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDEs y Editores (VS Code, IntelliJ, Eclipse, NetBeans) ──
.idea/
*.iws
*.iml
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
.classpath
.project
.settings/
.apt_generated
.factorypath
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
